# Copy to .env and fill in real values. Never commit .env.

# --- PostgreSQL ---
POSTGRES_DB=network_dashboard
POSTGRES_USER=dashboard_user
POSTGRES_PASSWORD=change_me_before_running
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Backend ---
LOG_LEVEL=info
LOG_JSON=false
# Comma-separated list of origins the API will accept CORS requests from.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

PING_COUNT=3
PING_TIMEOUT_SECONDS=2
PING_LATENCY_WARNING_MS=150
HTTP_TIMEOUT_SECONDS=5
TRACEROUTE_TIMEOUT_SECONDS=10

NMAP_TOP_PORTS=100
NMAP_TIMEOUT_SECONDS=180
NMAP_MAX_TOP_PORTS=1000

# Optional, off by default -- see README security section before enabling.
ENABLE_PACKET_CAPTURE=false
PACKET_CAPTURE_INTERFACE=any
PACKET_CAPTURE_DURATION_SECONDS=5
PACKET_CAPTURE_MAX_PACKETS=200

# --- Frontend ---
# Baked into the frontend build (Vite env vars are compile-time).
VITE_API_BASE_URL=http://localhost:8000

# --- Ports on the host ---
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=8080
